# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local Replica Set)
MONGODB_URI=mongodb://localhost:27017/hotel_booking_db

# JWT Secret & Expiry
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789
JWT_EXPIRES_IN=7d

# Booking Hold Expiry Duration in Minutes (Default: 10 minutes)
HOLD_EXPIRY_MINUTES=10
