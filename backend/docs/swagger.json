{
  "openapi": "3.0.0",
  "info": {
    "title": "Hotel Booking Management System API",
    "version": "1.0.0",
    "description": "Production REST API for ALGIONS AI LABS Hotel Booking Assessment with JWT RBAC, atomic hold & concurrency protection."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": { "description": "Server is operational" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register a new guest account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "phone": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "Validation error" },
          "409": { "description": "Email already exists" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/availability": {
      "get": {
        "summary": "Search available rooms by date range and guest count",
        "parameters": [
          { "name": "checkIn", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "checkOut", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "guests", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "roomTypeId", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of available rooms with calculated prices" },
          "400": { "description": "Invalid date range" }
        }
      }
    },
    "/api/bookings/holds": {
      "post": {
        "summary": "Create a 10-minute temporary room hold",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Hold created successfully" },
          "409": { "description": "Room already reserved or held" }
        }
      }
    },
    "/api/bookings/{id}/confirm": {
      "post": {
        "summary": "Confirm reservation with simulated payment",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Booking confirmed" },
          "400": { "description": "Hold expired" },
          "402": { "description": "Simulated payment failed" }
        }
      }
    },
    "/api/bookings/{id}/check-in": {
      "patch": {
        "summary": "Staff/Admin guest check-in",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Guest checked in" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/bookings/{id}/check-out": {
      "patch": {
        "summary": "Staff/Admin guest check-out",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Guest checked out" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/reports/summary": {
      "get": {
        "summary": "Admin/Staff dashboard KPIs, arrivals, departures, revenue",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Summary report" }
        }
      }
    }
  }
}
